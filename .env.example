# OpenAI-compatible API configuration (server-side only)
AI_API_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=your-model-name

# Optional server settings
PORT=3000
DATA_DIR=./data
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_OUTPUT_TOKENS=20000
AI_MAX_CONCURRENCY=2
AI_RATE_LIMIT_PER_HOUR=20
SESSION_DAYS=7
# Set true only after HTTPS is enabled.
COOKIE_SECURE=false

# Optional Docker build mirrors (useful for mainland China or restricted networks)
NODE_IMAGE=node:24-bookworm-slim
DEBIAN_MIRROR=deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=deb.debian.org/debian-security
